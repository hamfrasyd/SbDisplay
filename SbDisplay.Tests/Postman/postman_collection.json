	"item": [
		{
			"name": "200OK",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response is JSON\", function () {\r",
							"    pm.response.to.have.header(\"Content-Type\", \"application/json; charset=utf-8\");\r",
							"});\r",
							"\r",
							"pm.test(\"Returns exactly 3 orders\", function () {\r",
							"    const orders = pm.response.json();\r",
							"    pm.expect(orders).to.be.an(\"array\").with.lengthOf(3);\r",
							"});\r",
							"\r",
							"pm.test(\"First order matches seeded data\", function () {\r",
							"    const orders = pm.response.json();\r",
							"    const order = orders.find(o => o.transactionId === 1);\r",
							"\r",
							"    pm.expect(order).to.not.be.undefined;\r",
							"    pm.expect(order.id).to.eql(101);\r",
							"    pm.expect(order.status).to.eql(\"UnderPreparation\");\r",
							"    pm.expect(order.creationTimeUnix).to.eql(1700000000);\r",
							"});\r",
							"\r",
							"pm.test(\"Second order matches seeded data\", function () {\r",
							"    const orders = pm.response.json();\r",
							"    const order = orders.find(o => o.transactionId === 2);\r",
							"\r",
							"    pm.expect(order).to.not.be.undefined;\r",
							"    pm.expect(order.id).to.eql(102);\r",
							"    pm.expect(order.status).to.eql(\"ReadyForPickup\");\r",
							"});\r",
							"\r",
							"pm.test(\"Third order matches seeded data\", function () {\r",
							"    const orders = pm.response.json();\r",
							"    const order = orders.find(o => o.transactionId === 3);\r",
							"\r",
							"    pm.expect(order).to.not.be.undefined;\r",
							"    pm.expect(order.id).to.eql(103);\r",
							"    pm.expect(order.status).to.eql(\"Completed\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
